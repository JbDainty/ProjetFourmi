{
  "name": "color-world-herbier",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:web": "expo export --platform web && node scripts/offline.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "levels": "node --import tsx scripts/generate.ts",
    "preview": "node scripts/serve.mjs",
    "test:browser": "node --import tsx scripts/browser-smoke.ts",
    "format": "prettier --write app src scripts tests *.json *.ts *.md",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "test:pouring": "node --import tsx scripts/pouring-smoke.ts",
    "test:greenhouse": "node --import tsx scripts/greenhouse-smoke.ts",
    "test:mobile-herbarium": "node --import tsx scripts/mobile-herbarium-smoke.ts",
    "test:pencil": "node --import tsx scripts/pencil-smoke.ts",
    "test:victory": "node --import tsx scripts/victory-smoke.ts",
    "test:book": "node --import tsx scripts/book-smoke.ts"
  },
  "dependencies": {
    "@expo-google-fonts/alegreya": "^0.4.2",
    "@expo-google-fonts/alegreya-sans": "^0.4.2",
    "@expo-google-fonts/almendra": "^0.4.1",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.0",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "~19.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
