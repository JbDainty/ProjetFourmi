{
  "expo": {
    "name": "Herbier des couleurs",
    "slug": "color-world-herbier",
    "owner": "jbame",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "colorworld",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.colorworld.herbier"
    },
    "android": {
      "package": "com.colorworld.herbier",
      "versionCode": 2,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Herbier des couleurs",
      "shortName": "Herbier",
      "themeColor": "#315649",
      "backgroundColor": "#f4f0e5"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/b069af5c-3794-4f7d-b64b-5d45d4f0b1c0",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "b069af5c-3794-4f7d-b64b-5d45d4f0b1c0"
      }
    }
  }
}
